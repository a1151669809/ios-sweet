+/* Per-message contact update with state-change dedupe. */
+static void
+touch_slot(unsigned id, bool down, int x, int y)
+{
+	uint32_t bit = 1u << id;
+	if (down) {
+		if (!(st.active & bit) || x != st.x[id] || y != st.y[id]) {
+			sweet_hid_touch((int)id, 1, x, y);
+		}
+		st.x[id] = x;
+		st.y[id] = y;
+		st.active |= bit;
+	} else if (st.active & bit) {
+		sweet_hid_touch((int)id, 0, st.x[id], st.y[id]);
+		st.active &= ~bit;
+	}
+}
