 		return; /* spurious */
 	}
+	{
+		static volatile uint32_t sweet_irq_seen;
+		if (!sweet_irq_seen) {
+			sweet_irq_seen = 1;
+			kprintf("SWEET IRQ: first delivery intid=%u\n", intid);
+		}
+	}
 	if (intid == sweet_vtimer_intid) {
 		sleh_interrupt_handler_prologue(state, DBG_INTR_TYPE_TIMER);
 		cdp->cpu_decrementer = -1; /* Large */
